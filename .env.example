# PostgreSQL with the pgvector extension
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag

# Local Ollama embedding service. bge-m3 produces 1024-dimensional vectors.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024

# Shared secret required from NiFi in the X-API-Key HTTP header.
# Leave blank only for isolated local development.
NIFI_INGEST_API_KEY=
