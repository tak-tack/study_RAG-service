# PostgreSQL with the pgvector extension. Docker API 컨테이너는 이 외부 DB에 연결합니다.
# 로컬 DB를 사용한다면 localhost 주소를, 클라우드 DB를 사용한다면 해당 접속 URL을 넣으세요.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag

# Local Ollama embedding service. bge-m3 produces 1024-dimensional vectors.
OLLAMA_BASE_URL=http://localhost:11434
# Docker 컨테이너에서 호스트의 Ollama에 접속할 때 사용합니다.
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024

# Shared secret required from NiFi in the X-API-Key HTTP header.
# Leave blank only for isolated local development.
NIFI_INGEST_API_KEY=
