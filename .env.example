# PostgreSQL with the pgvector extension
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag

# Local Ollama embedding service. bge-m3 produces 1024-dimensional vectors.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024

# Finlife scheduled company synchronization.
FINLIFE_API_BASE_URL=https://finlife.fss.or.kr/finlifeapi/companySearch.json
FINLIFE_API_KEY=
FINLIFE_TOP_FIN_GRP_NOS=020000,030200,030300,050000,060000
FINLIFE_PAGE_NOS=1,2,3,4
